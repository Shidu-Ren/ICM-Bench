# Copy this file to .env and fill only the values required by your run.
# Never commit real credentials.

# Hosted model providers
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Optional OpenAI-compatible local or hosted endpoint
OPENAI_BASE_URL=

# Portable local roots
ICM_BENCH_DATA_ROOT=
ICM_BENCH_OUTPUT_ROOT=
ICM_BENCH_MODEL_ROOT=

# Optional device selection, for example: 0 or 0,1
CUDA_VISIBLE_DEVICES=
